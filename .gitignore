# ── Gradle / JVM ──────────────────────────────────────────────────────────
.gradle/
build/
out/
bin/
*.class
*.iml
hs_err_pid*.log
replay_pid*.log

# Keep the Gradle wrapper jar even though we ignore *.jar elsewhere
!gradle/wrapper/gradle-wrapper.jar

# ── Kotlin ────────────────────────────────────────────────────────────────
.kotlin/

# ── Generated code ────────────────────────────────────────────────────────
**/generated/
**/generated-src/
# `frontend/src/gen/` uses a whitelist in frontend/.gitignore: api.d.ts is
# committed (CI diffs it against a fresh regen), everything else stays
# untracked. See the `frontend-feature` skill § Generated types.

# ── Node / frontend (frontend/.gitignore also covers these inside the dir) ─
node_modules/

# ── IDE ───────────────────────────────────────────────────────────────────
# .idea: user-specific IntelliJ state. Shared run configs live in .run/ (tracked).
.idea/
.vscode/
.fleet/

# ── Claude Code ───────────────────────────────────────────────────────────
# Per-machine permission grants — not shared. `.claude/skills/` stays tracked:
# those are project context, same rationale as .run/ above.
.claude/settings.local.json

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets / env ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*-credentials.json
gcp-key.json
service-account*.json

# ── Helm ──────────────────────────────────────────────────────────────────
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/

# ── Spring Boot ───────────────────────────────────────────────────────────
HELP.md
.springBeans

# ── Docker volumes (local Postgres data) ──────────────────────────────────
.docker-volumes/
