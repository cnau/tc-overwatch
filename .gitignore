# ── Gradle / JVM ──────────────────────────────────────────────────────────
.gradle/
build/
out/
bin/
*.class
*.iml
hs_err_pid*.log
replay_pid*.log

# Keep the Gradle wrapper jar even though we ignore *.jar elsewhere
!gradle/wrapper/gradle-wrapper.jar

# ── Kotlin ────────────────────────────────────────────────────────────────
.kotlin/

# ── Generated protobuf / gRPC output ──────────────────────────────────────
proto/build/
**/generated/
**/generated-src/
frontend/src/gen/

# ── Node / frontend (frontend/.gitignore also covers these inside the dir) ─
node_modules/

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
.fleet/

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets / env ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*-credentials.json
gcp-key.json
service-account*.json

# ── Helm ──────────────────────────────────────────────────────────────────
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/

# ── Spring Boot ───────────────────────────────────────────────────────────
HELP.md
.springBeans

# ── Docker volumes (local Postgres data) ──────────────────────────────────
.docker-volumes/
