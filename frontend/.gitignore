# Generated by `npm run gen-api-types` — only the OpenAPI types file is committed;
# anything else that lands in src/gen/ stays untracked unless explicitly whitelisted.
# Pattern: ignore files *inside* the dir (src/gen/*), not the dir itself — git
# can't re-include a file under an excluded parent directory.
src/gen/*
!src/gen/api.d.ts
